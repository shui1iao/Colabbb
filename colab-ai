    cur.token_expires_at = a.runtime_proxy_info.expires_at()
    state.store.add(cur)
    print(f"ATTACHED:{{cur.endpoint}}:{{cur.accelerator}}")
    raise SystemExit(0)

target = None
for a in assignments:
    if a.accelerator.value.upper() == "G4":
        target = a
        break
if target is None:
    target = assignments[0]

s = SessionState(
    name={session!r},
