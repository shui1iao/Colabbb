def _resolve_colab_python() -> str:
    env_py = os.environ.get("COLAB_PYTHON_BIN", "").strip()
    if env_py and os.path.isfile(env_py):
        return env_py
    try:
        if os.path.isfile(COLAB_BIN):
            with open(COLAB_BIN, "r", encoding="utf-8", errors="ignore") as fh:
                first = fh.readline().strip()
            if first.startswith("#!"):
                interp = first[2:].strip().split()[0]
                if os.path.isfile(interp):
                    return interp
    except OSError:
        pass
    uv_py = os.path.expanduser("~/.local/share/uv/tools/google-colab-cli/bin/python")
    if os.path.isfile(uv_py):
        return uv_py
    return sys.executable


def _ensure_tunnel_keypair() -> str:
    """读取或自动生成本机专属 ${STATE_DIR}/tunnel_ed25519 密钥对，返回私钥 Base64。"""
    env_b64 = os.environ.get("COLABBB_TUNNEL_KEY_B64", "").strip()
    if env_b64:
        return env_b64
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    key_file = os.path.join(STATE_DIR, "tunnel_ed25519")
    if not os.path.isfile(key_file) and shutil.which("ssh-keygen"):
        subprocess.run(
            ["ssh-keygen", "-t", "ed25519", "-N", "", "-C", "colabbb-tunnel", "-f", key_file],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False,
        )
        if os.path.isfile(key_file):
            os.chmod(key_file, 0o600)
            print(
                f'[colab-ai] 已自动生成反向隧道密钥对: {key_file}\n'
                '[colab-ai] 容器内置 sshd 会在启动时自动授权此密钥；无需改动宿主机 SSH。',
                flush=True,
            )
    if os.path.isfile(key_file):
        os.chmod(key_file, 0o600)
        with open(key_file, "rb") as fh:
            return base64.b64encode(fh.read()).decode("ascii")
    return ""


def _read_optional_secret(env_name: str, dotfile_name: str) -> str:
    val = os.environ.get(env_name, "").strip()
    if val:
        return val
    p = os.path.join(STATE_DIR, dotfile_name)
    if os.path.isfile(p):
        try:
            return open(p, "r", encoding="utf-8").read().strip()
        except OSError:
            return ""
    return ""


