def _run_parallel_dual_warmup(targets: list, session: str):
    has_llm = "llm" in targets
    has_media = any(t != "llm" for t in targets)
    with ExitStack() as stack:
        if has_llm:
            stack.enter_context(model_initialization_lock(session, "llm"))
        if has_media:
            stack.enter_context(model_initialization_lock(session, "media"))
        _check_generation()
        touch_activity()
        ri_b64 = base64.b64encode(open(os.path.join(BASE_DIR, "remote_image.py"), "rb").read()).decode("ascii")
        rv_b64 = base64.b64encode(open(os.path.join(BASE_DIR, "remote_video.py"), "rb").read()).decode("ascii")
        rl_b64 = base64.b64encode(open(os.path.join(BASE_DIR, "remote_llm.py"), "rb").read()).decode("ascii")
        rm_b64 = base64.b64encode(open(os.path.join(BASE_DIR, "remote_metrics.py"), "rb").read()).decode("ascii")
        settings_json = json.dumps(load_studio_settings(), ensure_ascii=False)

        media_targets = [t for t in targets if t != "llm"]
        runner_code = (
            "import base64, json, os, subprocess, sys, threading\n"
            f"ri_b64 = {ri_b64!r}\n"
            f"rv_b64 = {rv_b64!r}\n"
            f"rl_b64 = {rl_b64!r}\n"
            f"rm_b64 = {rm_b64!r}\n"
            "open('/content/_ri_warm.py', 'wb').write(base64.b64decode(ri_b64))\n"
            "open('/content/_rv_warm.py', 'wb').write(base64.b64decode(rv_b64))\n"
            "open('/content/_rl_warm.py', 'wb').write(base64.b64decode(rl_b64))\n"
            "open('/content/_rm_warm.py', 'wb').write(base64.b64decode(rm_b64))\n"
            "subprocess.Popen([sys.executable, '/content/_rm_warm.py'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)\n"
            "plock = threading.Lock()\n"
            "rcs = {}\n"
            "def _exec_step(script, args, ok_target):\n"
            "    env = os.environ.copy()\n"
            "    env['COLAB_AI_ARGS_JSON'] = json.dumps(args)\n"
            "    p = subprocess.Popen([sys.executable, script], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1, env=env)\n"
            "    for line in p.stdout:\n"
            "        with plock:\n"
            "            sys.stdout.write(line)\n"
            "            sys.stdout.flush()\n"
            "    rc = p.wait()\n"
            "    if rc == 0:\n"
            "        with plock:\n"
            "            print('COLAB_AI_WARMUP_TARGET_OK=' + ok_target, flush=True)\n"
            "    return rc\n"
            f"media_targets = {media_targets!r}\n"
            f"has_llm = {has_llm!r}\n"
            "def _run_media():\n"
            "    for mt in media_targets:\n"
            "        if mt == 'video':\n"
            "            rc = _exec_step('/content/_rv_warm.py', ['--warmup-only'], 'video')\n"
            "        else:\n"
            "            rc = _exec_step('/content/_ri_warm.py', ['--warmup-only', '--model', mt], mt)\n"
            "        if rc != 0:\n"
            "            rcs['media'] = rc\n"
            "            return\n"
            "    rcs['media'] = 0\n"
            "def _run_llm():\n"
            "    rcs['llm'] = _exec_step('/content/_rl_warm.py', ['--warmup-only'], 'llm')\n"
            "threads = []\n"
            "if media_targets:\n"
            "    threads.append(threading.Thread(target=_run_media))\n"
            "if has_llm:\n"
            "    threads.append(threading.Thread(target=_run_llm))\n"
            "for th in threads: th.start()\n"
            "for th in threads: th.join()\n"
            "if (media_targets and rcs.get('media') != 0) or (has_llm and rcs.get('llm') != 0):\n"
            "    raise SystemExit(1)\n"
        )
        os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
        tmp_runner = os.path.join(STATE_DIR, f".dual_warmup_{os.getpid()}_{int(time.time()*1000)}.py")
        with open(tmp_runner, "w", encoding="utf-8") as fh:
            fh.write(runner_code)
        try:
            for t in targets:
                print("COLAB_AI_WARMUP_TARGET_BEGIN=" + t, flush=True)
            all_lbls = " + ".join(MODEL_LABELS.get(t, t) for t in targets)
            print(f"[colab-ai] 正在并行极速预热所选项目: {all_lbls} ...", flush=True)
            cmd = (
                [COLAB_BIN, "exec", "-s", session, "--timeout", str(DEFAULT_TIMEOUT)]
                + _build_remote_env_flags({"COLAB_AI_SETTINGS_JSON": settings_json})
                + ["-f", tmp_runner]
            )
            rc = 1
            for _try in range(2):
                _check_generation()
                if not auto_attach_remote_session(session):
                    raise SystemExit("[colab-ai] 当前未开机或预热期间实例已消失，请先开机。")
                proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
                lines = []
                for line in proc.stdout:
                    lines.append(line)
                    sys.stdout.write(line)
                    sys.stdout.flush()
                rc = proc.wait()
                touch_activity()
                if rc == 0:
                    for _tw in range(20):
                        ok_media = (not has_media) or _is_tunnel_live(COMFY_TUNNEL_PORT)
                        ok_llm = (not has_llm) or _is_tunnel_live(LLM_TUNNEL_PORT)
                        if ok_media and ok_llm:
                            break
                        time.sleep(0.3)
                    break
                joined = "".join(lines)
                if ("Connection was lost" in joined or "Websocket handshake timed out" in joined) and _try == 0:
                    print("[colab-ai] 预热连接闪断，2秒后自动续接预热...", flush=True)
                    time.sleep(2)
                    continue
                break
            if rc != 0:
                raise SystemExit(rc)
        finally:
            try:
                os.unlink(tmp_runner)
            except OSError:
                pass


def _main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print("用法: colab-ai <status|start|warmup|stop|unload|image|video|llm> [参数...]")
        return

    sub = sys.argv[1]
    if sub.lower() in ("edit", "image_edit"):
        raise SystemExit("改图模块暂未启用")
    image_args = sys.argv[3:] if sub == "run" and len(sys.argv) > 2 and sys.argv[2] == "image" else sys.argv[2:]
    if sub == "image" or (sub == "run" and len(sys.argv) > 2 and sys.argv[2] == "image"):
        _validate_image_args(image_args)
    if sub == "run" and len(sys.argv) > 2 and sys.argv[2].lower() in ("edit", "image_edit"):
        raise SystemExit("改图模块暂未启用")
    if sub not in ("status", "stop") and "COLAB_AI_GENERATION" not in os.environ:
        try:
            with open(_generation_path()) as fh:
                os.environ["COLAB_AI_GENERATION"] = fh.read().strip()
        except FileNotFoundError:
            os.environ["COLAB_AI_GENERATION"] = "0"
    _check_generation()
    rest = sys.argv[2:]
    session = DEFAULT_SESSION
    gpu = DEFAULT_GPU
    idle_min = DEFAULT_IDLE_MIN
    mod_names = "|".join(MODULES.keys())

    if "--existing-only" in rest:
        if sub == "image":
            direct_args = rest
        elif sub == "run" and rest and rest[0] == "image":
            direct_args = rest[1:]
        else:
            raise SystemExit("[colab-ai] --existing-only 仅用于 image；未执行其他入口")
        _run_existing_image([arg for arg in direct_args if arg != "--existing-only"])
        return

    if sub == "status":
        cmd_status(session)
    elif sub == "accounts":
        cmd_accounts()
    elif sub == "switch":
        cmd_switch_account(rest)
    elif sub == "stop":
        cmd_stop(session)
    elif sub == "start":
        ensure_session(session, gpu, idle_min)
    elif sub == "warmup":
        try:
            targets = _parse_warmup_args(rest)
        except ValueError as exc:
            raise SystemExit(str(exc)) from None
        ensure_session(session, gpu, idle_min, allow_create=False)
        if len(targets) > 1:
            _run_parallel_dual_warmup(targets, session)
        else:
            for target in targets:
                print("COLAB_AI_WARMUP_TARGET_BEGIN=" + target, flush=True)
                print("[colab-ai] 正在预热项目: " + MODEL_LABELS.get(target, "提示词 LLM") + " ...", flush=True)
                mod = "llm" if target == "llm" else ("video" if target == "video" else "image")
                warm_args = ["--warmup-only"] if mod in ("llm", "video") else ["--warmup-only", "--model", target]
                run_module_in_session(mod, warm_args, session, allow_create=False)
                print("COLAB_AI_WARMUP_TARGET_OK=" + target, flush=True)
    elif sub == "unload":
        if not has_active_session(session):
            print("[colab-ai] 当前未开机。", flush=True)
            return
        target = rest[0] if rest else "all"
        subprocess.run(
            [COLAB_BIN, "exec", "-s", session]
            + _build_remote_env_flags({"COLAB_AI_ARGS_JSON": json.dumps([target])})
            + ["-f", os.path.join(BASE_DIR, "remote_unload.py")],
            check=True,
        )
    elif sub == "run":
        if not rest or rest[0] not in MODULES:
            raise SystemExit(f"用法: colab-ai run <{mod_names}> [参数...]")
        mod = rest[0]
        mod_args = rest[1:]
        run_module_in_session(mod, mod_args, session)
    elif sub in MODULES:
        run_module_in_session(sub, rest, session)
    else:
        raise SystemExit(f"未知命令或模块: {sub}")


def main():
    sub = sys.argv[1] if len(sys.argv) > 1 else "help"
    if sub == "_idle_watch":
        session, generation, fd = sys.argv[2:5]
        guard = idle_guard(session)
        guard.watch(
            generation,
            int(fd),
            lambda token: cmd_stop(session, _claim=token),
            keepalive=lambda gen: cmd_kernel_keepalive(session, expected_gen=gen),
            keepalive_interval=300,
        )
    elif sub == "_kernel_keepalive":
        session = sys.argv[2] if len(sys.argv) > 2 else DEFAULT_SESSION
        gen = sys.argv[3] if len(sys.argv) > 3 else None
        cmd_kernel_keepalive(session, expected_gen=gen)
    elif sub in ("status", "accounts", "switch", "stop", "help", "-h", "--help"):
        _main()
    else:
        try:
            with idle_guard().lease(os.environ.get("COLAB_AI_GENERATION")) as lease:
                os.environ.setdefault("COLAB_AI_GENERATION", lease.generation)
                _main()
        except IdleError as exc:
            raise SystemExit("[idle] " + str(exc)) from None


