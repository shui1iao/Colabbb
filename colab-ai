def trigger_async_kernel_keepalive(session: str = None):
    session = session or DEFAULT_SESSION
    if not _keepalive_due(session, KERNEL_KEEPALIVE_COOLDOWN):
        return
    try:
        guard = idle_guard(session)
        gen = guard.generation()
        _, _, log_p = _keepalive_paths(session)
        os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
        with open(log_p, "a", encoding="utf-8") as lf:
            subprocess.Popen(
                [sys.executable, os.path.realpath(__file__), "_kernel_keepalive", session, gen],
                stdout=lf, stderr=lf, start_new_session=True,
            )
    except Exception:
        pass


def cmd_kernel_keepalive(session: str, expected_gen: str = None, cooldown_sec: int = KERNEL_KEEPALIVE_COOLDOWN):
    session = session or DEFAULT_SESSION
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    lock_p, _, _ = _keepalive_paths(session)
    with open(lock_p, "a+") as lk:
        try:
            fcntl.flock(lk.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        guard = idle_guard(session)
        with guard.gate():
            if expected_gen is not None and expected_gen != guard.generation():
                return
            try:
                data = guard.read(repair=False)
            except IdleError:
                return
            limit = data.get("limit", 3600)
            if data.get("phase") != "running" or limit <= 0 or guard.now() - data["last"] >= limit:
                return
        if not _keepalive_due(session, cooldown_sec):
            return
        helper_code = (
            "import json, sys, requests\n"
            "from colab_cli.common import state\n"
            "from colab_cli.runtime import ColabRuntime\n"
            "sess_name = sys.argv[1]\n"
            "assignments = state.client.list_assignments()\n"
            "if not assignments:\n"
            "    print('KA_RESULT=empty')\n"
            "    raise SystemExit(0)\n"
            "by_ep = {a.endpoint: a for a in assignments}\n"
            "cur = state.store.get(sess_name)\n"
            "target = by_ep.get(cur.endpoint) if (cur and cur.endpoint in by_ep) else None\n"
            "if target is None:\n"
            "    for a in assignments:\n"
            "        if a.accelerator.value.upper() == 'G4':\n"
            "            target = a\n"
            "            break\n"
            "    if target is None:\n"
            "        target = assignments[0]\n"
            "url = target.runtime_proxy_info.url\n"
            "tok = target.runtime_proxy_info.token\n"
            "ep = target.endpoint\n"
            "if cur and cur.endpoint == ep:\n"
            "    cur.token = tok\n"
            "    cur.url = url\n"
            "    cur.token_expires_at = target.runtime_proxy_info.expires_at()\n"
            "    state.store.add(cur)\n"
            "hdrs = {'X-Colab-Client-Agent': 'colab-cli', 'X-Colab-Runtime-Proxy-Token': tok}\n"
            "r = requests.get(f'{url}/api/kernels', headers=hdrs, timeout=10)\n"
            "r.raise_for_status()\n"
            "ks = r.json()\n"
            "if ks and any(k.get('execution_state') != 'idle' for k in ks):\n"
            "    print(f'KA_RESULT=busy_active:{ep}')\n"
            "    raise SystemExit(0)\n"
            "kid = ks[0]['id'] if ks else (cur.kernel_id if cur and cur.endpoint == ep else None)\n"
            "rt = ColabRuntime(url, tok, kernel_id=kid)\n"
            "try:\n"
            "    rt.execute_code('1+1', timeout=15)\n"
            "    if cur and cur.endpoint == ep and rt.kernel_id and cur.kernel_id != rt.kernel_id:\n"
            "        cur.kernel_id = rt.kernel_id\n"
            "        state.store.add(cur)\n"
            "finally:\n"
            "    rt.stop()\n"
            "print(f'KA_RESULT=refreshed:{ep}')\n"
        )
        try:
            res = subprocess.run(
                [_resolve_colab_python(), "-c", helper_code, session],
                capture_output=True, text=True, timeout=30,
            )
            out_lines = [ln.strip() for ln in (res.stdout or "").splitlines() if ln.startswith("KA_RESULT=")]
            if res.returncode == 0 and out_lines:
                val = out_lines[-1].split("=", 1)[1]
                parts = val.split(":", 1)
                st_name = parts[0]
                ep_name = parts[1] if len(parts) > 1 else ""
                if st_name in ("refreshed", "busy_active"):
                    _write_keepalive_stamp(session, ep_name, st_name)
                _lifecycle_event("kernel_keepalive", status=st_name, endpoint=ep_name)
            else:
                _lifecycle_event("kernel_keepalive", status="error", returncode=res.returncode)
        except Exception as exc:
            _lifecycle_event("kernel_keepalive", status="exception", error_type=type(exc).__name__)


def touch_activity():
    idle_guard().touch()


def start_idle_watcher(session: str, idle_minutes: int):
    idle_guard(session).ensure_watcher(os.path.realpath(__file__), idle_minutes)


def idle_work(func):
    def protected(*args, **kwargs):
        session = kwargs.get("session") or (args[0] if func.__name__ == "ensure_session" else args[2])
        try:
            with idle_guard(session).lease(os.environ.get("COLAB_AI_GENERATION")):
                return func(*args, **kwargs)
        except IdleError as exc:
            raise SystemExit("[idle] " + str(exc)) from None
    return protected


@contextmanager
def session_start_lock(session: str, timeout=None):
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    key = hashlib.sha256(session.encode("utf-8")).hexdigest()
    path = os.path.join(STATE_DIR, f"session-start-{key}.lock")
    with open(path, "a+") as lock:
        if timeout is None:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        else:
            deadline = time.monotonic() + timeout
            while True:
                try:
                    fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if time.monotonic() >= deadline:
                        raise IdleError("session transition lock timed out; shutdown unconfirmed")
                    time.sleep(0.05)
        try:
            yield lock
        finally:
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def _set_start_pending(lock, pending: bool):
    lock.seek(0)
    lock.truncate()
    if pending:
        lock.write("NEW_UNCONFIRMED\n")
    lock.flush()
    os.fsync(lock.fileno())


def auto_attach_remote_session(session: str) -> bool:
    with session_start_lock(session) as lock:
        attached = _auto_attach_remote_session_locked(session)
        if attached:
            _set_start_pending(lock, False)
            start_idle_watcher(session, DEFAULT_IDLE_MIN)
        return attached


def _auto_attach_remote_session_locked(session: str) -> bool:
    code = f'''
from colab_cli.common import state
from colab_cli.state import SessionState
import json

assignments = state.client.list_assignments()
if not isinstance(assignments, list):
    raise RuntimeError("Invalid assignments response")
print("COLAB_AI_ASSIGNMENTS_JSON=" + json.dumps([a.endpoint for a in assignments]), flush=True)
if not assignments:
    print("COLAB_AI_ASSIGNMENTS_EMPTY")
    raise SystemExit(3)

by_ep = {{a.endpoint: a for a in assignments}}
