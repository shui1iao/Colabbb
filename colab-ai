def _build_remote_env_flags(extra_env: dict = None) -> list:
    env_map = {}
    tunnel_b64 = _ensure_tunnel_keypair()
    tunnel_host = os.environ.get("COLABBB_TUNNEL_HOST", "").strip()
    tunnel_port = os.environ.get("COLABBB_TUNNEL_PORT", "22222").strip() or "22222"
    tunnel_user = os.environ.get("COLABBB_TUNNEL_USER", "tunnel").strip() or "tunnel"

    if tunnel_b64:
        env_map["COLABBB_TUNNEL_KEY_B64"] = tunnel_b64
    if tunnel_host:
        env_map["COLABBB_TUNNEL_HOST"] = tunnel_host
    env_map["COLABBB_TUNNEL_PORT"] = tunnel_port
    env_map["COLABBB_TUNNEL_USER"] = tunnel_user

    civ_tok = _read_optional_secret("CIVITAI_TOKEN", ".civitai_token")
    hf_tok = _read_optional_secret("HF_TOKEN", ".hf_token")
    if civ_tok:
        env_map["CIVITAI_TOKEN"] = civ_tok
    if hf_tok:
        env_map["HF_TOKEN"] = hf_tok

    for k, v in os.environ.items():
        if v and k.startswith(PASSTHROUGH_REMOTE_ENV_PREFIXES):
            env_map[k] = v

    if extra_env:
        for k, v in extra_env.items():
            if v is not None:
                env_map[k] = str(v)

    flags = []
    for k, v in env_map.items():
        flags.extend(["--env", f"{k}={v}"])
    return flags


