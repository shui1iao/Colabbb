        _submit_comfy_tunnel(wf, f"24fps 声画视频 {q_lbl} ({sec}s/{length}帧)", "vid", s2_w, s2_h, tot_steps, seed, out_subdir="video", ext=".mp4")
        return True
    except Exception as e:
        print(f"[video] 隧道直连异常 ({e})，回退至标准通道...", flush=True)
        return False


def _generation_path(session=None):
    key = hashlib.sha256((session or DEFAULT_SESSION).encode()).hexdigest()
    return os.path.join(STATE_DIR, "power-generation-" + key)


def _check_generation(session=None):
    expected = os.environ.get("COLAB_AI_GENERATION")
    if expected is None:
        return
    try:
        with open(_generation_path(session)) as fh:
            current = fh.read().strip()
    except FileNotFoundError:
        current = "0"
    if expected != current:
        raise SystemExit("[colab-ai] 旧任务已因关机暂停，禁止重试或重新开机；请手动继续。")


@contextmanager
def model_initialization_lock(session, lane: str = "media"):
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    key = hashlib.sha256(session.encode()).hexdigest()
    with open(os.path.join(STATE_DIR, f"model-init-{lane}-{key}.lock"), "a+") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        try:
            _check_generation()
            yield
        finally:
            fcntl.flock(fh, fcntl.LOCK_UN)


@idle_work
def run_module_in_session(module: str, mod_args: list, session: str, allow_create: bool = True):
    if module == "image":
        _validate_image_args(mod_args)
    _check_generation()
    if not allow_create:
        ensure_session(session, DEFAULT_GPU, DEFAULT_IDLE_MIN, allow_create=False)
    direct = {"image": _try_direct_tunnel_image, "video": _try_direct_tunnel_video, "llm": _try_direct_tunnel_llm}.get(module)
    if direct and direct(mod_args):
        touch_activity()
        start_idle_watcher(session, DEFAULT_IDLE_MIN)
        trigger_async_kernel_keepalive(session)
        return
    _lane = "llm" if module == "llm" else "media"
    with model_initialization_lock(session, _lane):
        _run_module_cold(module, mod_args, session, allow_create=allow_create)


def _run_module_cold(module: str, mod_args: list, session: str, allow_create: bool = True):
    if module == "image":
        _validate_image_args(mod_args)
    _check_generation()
    touch_activity()
    ensure_session(session, DEFAULT_GPU, DEFAULT_IDLE_MIN, allow_create=allow_create)
    if module == "llm" and "--warmup-only" not in mod_args:
        if _try_direct_tunnel_llm(mod_args):
            touch_activity()
            trigger_async_kernel_keepalive(session)
            return
        _run_module_cold("llm", ["--warmup-only"], session, allow_create=allow_create)
        if _try_direct_tunnel_llm(mod_args):
            touch_activity()
            trigger_async_kernel_keepalive(session)
            return
    if module == "image" and _try_direct_tunnel_image(mod_args):
        touch_activity()
        trigger_async_kernel_keepalive(session)
        return
    if module == "video" and _try_direct_tunnel_video(mod_args):
        touch_activity()
        trigger_async_kernel_keepalive(session)
        return

    script_path = os.path.join(BASE_DIR, MODULES[module])
    remote_args = prepare_remote_args(module, mod_args, session)
    args_json = json.dumps(remote_args, ensure_ascii=False)
    settings_json = json.dumps(load_studio_settings(), ensure_ascii=False)

    def _make_exec_cmd(cur_args_json: str, cur_settings_json: str):
        return (
            [COLAB_BIN, "exec", "-s", session, "--timeout", str(DEFAULT_TIMEOUT)]
            + _build_remote_env_flags({
                "COLAB_AI_ARGS_JSON": cur_args_json,
                "COLAB_AI_SETTINGS_JSON": cur_settings_json,
            })
            + ["-f", script_path]
        )

    cmd = _make_exec_cmd(args_json, settings_json)
    output_files = []
    rc = 1
    for _exec_try in range(3):
        _check_generation()
        if not auto_attach_remote_session(session) and not allow_create:
            raise SystemExit("[colab-ai] 当前未开机或预热期间实例已消失，请先开机。")
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
        output_files = []
        collected_lines = []
        for line in proc.stdout:
            collected_lines.append(line)
            if line.startswith("COLAB_AI_OUTPUT_FILE="):
                output_files.append(line.split("=", 1)[1].strip())
            else:
                sys.stdout.write(line)
                sys.stdout.flush()
        rc = proc.wait()
        touch_activity()
        if rc == 0:
            break
        joined = "".join(collected_lines)
        if ("Connection was lost" in joined or "not found" in joined or "Websocket handshake timed out" in joined) and _exec_try < 2:
            print(f"[colab-ai] 检测到 Colab 连接或实例变动，3秒后自动重连/自愈重试 ({_exec_try+1}/2)...", flush=True)
            time.sleep(3)
            _check_generation()
            ensure_session(session, DEFAULT_GPU, DEFAULT_IDLE_MIN, allow_create=allow_create)
            remote_args = prepare_remote_args(module, mod_args, session)
            cmd = _make_exec_cmd(
                json.dumps(remote_args, ensure_ascii=False),
                json.dumps(load_studio_settings(), ensure_ascii=False),
            )
            continue
        break
    if rc != 0:
        raise SystemExit(rc)
    if "--warmup-only" not in mod_args and not output_files:
        print(f"[colab-ai] 错误: 远端执行未产出任何结果文件 (module={module})", flush=True)
        raise SystemExit(1)

    llm_out_file = ""
    llm_ephemeral_draft = False
    if module == "llm":
        _lp = argparse.ArgumentParser()
        _lp.add_argument("--out-file", default="")
        _lp.add_argument("--ephemeral-draft", action="store_true")
        _la, _ = _lp.parse_known_args(mod_args)
        llm_out_file = (_la.out_file or "").strip()
        llm_ephemeral_draft = bool(_la.ephemeral_draft)

    local_out_dir = os.path.join(OUT_ROOT, module)
    os.makedirs(local_out_dir, exist_ok=True)
    for rpath in output_files:
        if module == "llm" and llm_ephemeral_draft and llm_out_file:
            os.makedirs(os.path.dirname(os.path.abspath(llm_out_file)), exist_ok=True)
            subprocess.run([COLAB_BIN, "download", "-s", session, rpath, llm_out_file], check=True)
            print(f"[colab-ai] 已回传至宿主机本地: {llm_out_file}", flush=True)
        else:
            lpath = os.path.join(local_out_dir, os.path.basename(rpath))
            subprocess.run([COLAB_BIN, "download", "-s", session, rpath, lpath], check=True)
            if module == "llm" and llm_out_file:
                os.makedirs(os.path.dirname(os.path.abspath(llm_out_file)), exist_ok=True)
                shutil.copyfile(lpath, llm_out_file)
            print(f"[colab-ai] 已回传至宿主机本地: {lpath}", flush=True)


