        return None


def _lifecycle_event(event, **fields):
    try:
        record = dict(ts=time.time(), pid=os.getpid(), event=event, **fields)
        print("[lifecycle-audit] " + json.dumps(record, ensure_ascii=True), file=sys.stderr, flush=True)
    except (OSError, ValueError, TypeError):
        pass


KERNEL_KEEPALIVE_COOLDOWN = 240


def _keepalive_paths(session: str):
    key = hashlib.sha256((session or DEFAULT_SESSION).encode("utf-8")).hexdigest()
    return (
        os.path.join(STATE_DIR, f"kernel-keepalive-{key}.lock"),
        os.path.join(STATE_DIR, f"kernel-keepalive-{key}.json"),
        os.path.join(STATE_DIR, f"idle-{key}.log"),
    )


def _keepalive_due(session: str, cooldown_sec: int = KERNEL_KEEPALIVE_COOLDOWN) -> bool:
    _, state_p, _ = _keepalive_paths(session)
    try:
        st = json.load(open(state_p, "r", encoding="utf-8"))
        boot = open("/proc/sys/kernel/random/boot_id").read().strip()
        now_m = time.monotonic()
        if st.get("boot") == boot and isinstance(st.get("mono"), (int, float)) and 0 <= now_m - st["mono"] < cooldown_sec:
            return False
    except Exception:
        pass
    return True


def _write_keepalive_stamp(session: str, endpoint: str, status: str):
    _, state_p, _ = _keepalive_paths(session)
    try:
        boot = open("/proc/sys/kernel/random/boot_id").read().strip()
        payload = {"boot": boot, "mono": time.monotonic(), "ts": time.time(), "endpoint": endpoint, "status": status}
        tmp_p = state_p + ".tmp"
        with open(tmp_p, "w", encoding="utf-8") as fh:
