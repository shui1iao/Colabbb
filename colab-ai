        "top_k": llm_cfg["top_k"],
        "repeat_penalty": llm_cfg["repeat_penalty"],
        "multi_turn_hint": llm_cfg["multi_turn_hint"],
        "check_prefix": llm_cfg["check_prefix"],
        "strip_terms": llm_cfg["strip_terms"],
    }

