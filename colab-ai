def cmd_stop(session: str, _claim=None):
    guard = idle_guard(session)
    call_type = "automatic" if _claim else "manual"
    _lifecycle_event("stop_entry", call_type=call_type, generation=guard.generation(), endpoint=_local_endpoint(session))
    token = _claim or guard.claim_stop(expected=os.environ.get("COLAB_AI_GENERATION"))
    _lifecycle_event("stop_claimed", call_type=call_type, generation=token, endpoint=_local_endpoint(session))
    os.environ["COLAB_AI_GENERATION"] = token
    attempt = False
    try:
        if not guard.begin_attempt(token):
            return
        attempt = True
        start_idle_watcher(session, DEFAULT_IDLE_MIN)
        with session_start_lock(session, timeout=30):
            _check_generation(session)
            if _auto_attach_remote_session_locked(session):
                print("[lifecycle] stop requested; automatic retry fenced", flush=True)
                target_endpoint = _local_endpoint(session)
                _lifecycle_event("stop_call_begin", call_type=call_type, generation=token, endpoint=target_endpoint, operation="sdk_stop_shutdown_and_unassign")
                try:
                    subprocess.run([COLAB_BIN, "stop", "-s", session], check=True, timeout=90)
                except (Exception, SystemExit) as exc:
                    _lifecycle_event("stop_call_end", call_type=call_type, generation=token, endpoint=target_endpoint, result="unconfirmed", error_type=type(exc).__name__)
                    raise
                _lifecycle_event("stop_call_end", call_type=call_type, generation=token, endpoint=target_endpoint, result="returned_success")
                if _auto_attach_remote_session_locked(session):
                    raise IdleError("关机后实例仍在，未确认释放")
            guard.finish_stop(token, True)
            _lifecycle_event("stop_verified_empty", call_type=call_type, generation=token)
            print("[colab-ai] 已确认无活跃实例。", flush=True)
    except (Exception, SystemExit) as exc:
        _lifecycle_event("stop_unconfirmed", call_type=call_type, generation=token, error_type=type(exc).__name__)
        if attempt:
            guard.finish_stop(token, False, type(exc).__name__)
            start_idle_watcher(session, DEFAULT_IDLE_MIN)
        raise SystemExit("[colab-ai] 关机未确认，任务保持暂停；监控保留，自动重试最多3次，请核实或手动重试关机。") from None


