        os.makedirs(local_out_dir, exist_ok=True)
        lpath = os.path.join(local_out_dir, f"llm_{int(time.time()*1000)%1000000000}.md")
        with open(lpath, "w", encoding="utf-8") as fh:
            fh.write(reply + "\n")
        print(f"[colab-ai] 已回传至宿主机本地: {lpath}", flush=True)
    elif args.out_file:
        print(f"[colab-ai] 已回传至宿主机本地: {args.out_file}", flush=True)
    return True


def _clean_prompt_terms_local(prompt: str, img_prompt_cfg: dict = None) -> str:
    p = prompt.strip()
    cfg = img_prompt_cfg if isinstance(img_prompt_cfg, dict) else load_studio_settings()["image_prompt"]
    if not cfg.get("enable_clean", True):
        return p
    for rx in (cfg.get("strip_regexes") or []):
        if isinstance(rx, str) and rx:
            try:
                p = re.sub(rx, "。", p)
            except re.error as exc:
                print(f"[image] 忽略无效的清理正则 {rx!r}: {exc}", flush=True)
    for pair in (cfg.get("replace_pairs") or []):
        if isinstance(pair, dict):
            old_s = pair.get("from", "")
            new_s = pair.get("to", "")
            if isinstance(old_s, str) and old_s and isinstance(new_s, str):
                p = p.replace(old_s, new_s)
    return p.strip()


def _apply_prompt_affixes_local(prompt: str, img_prompt_cfg: dict = None) -> str:
    cfg = img_prompt_cfg if isinstance(img_prompt_cfg, dict) else load_studio_settings()["image_prompt"]
    p = _clean_prompt_terms_local((prompt or "").lstrip("-# \n\r\t").strip(), cfg)
    if not p:
        return ""
    has_zh = bool(re.search(r"[\u4e00-\u9fff]", p))
    if cfg.get("enable_prefix", False):
        pref = ((cfg.get("zh_prefix") if has_zh else cfg.get("en_prefix")) or "").strip()
        if pref and not p.startswith(pref):
            if has_zh:
                sep = "" if pref[-1] in "，。；、：,.;:" else "，"
                p = f"{pref}{sep}{p}"
            else:
                sep = " " if pref[-1] in ",.;:" else ", "
                p = f"{pref}{sep}{p}"
    if cfg.get("enable_suffix", True):
        if has_zh:
            zh_suf = (cfg.get("zh_suffix") or "").strip()
            if zh_suf and zh_suf not in p:
                p = p.rstrip("。 ") + "。" + zh_suf.lstrip("。 ")
        else:
            en_suf = (cfg.get("en_suffix") or "").strip()
            if en_suf and en_suf.lower() not in p.lower():
                p = p.rstrip(". ") + ". " + en_suf.lstrip(". ")
    return p


def _format_ref_face_prompt(clean_p: str, img_prompt_cfg: dict) -> str:
    tpl = (img_prompt_cfg.get("ref_face_prompt") or "").strip()
    if not tpl:
        return clean_p
    if "{prompt}" in tpl:
        return tpl.replace("{prompt}", clean_p)
    return f"{tpl.rstrip()} {clean_p}"


def _resolve_res_and_steps(wf_cfg: dict, width: int, height: int, raw_steps: int, res_mode: str = "", step_tier: str = ""):
    rm = (res_mode or "").strip().lower()
    if rm not in ("portrait", "landscape", "square"):
        if height > width:
            rm = "portrait"
        elif width > height:
            rm = "landscape"
        else:
            rm = "square"
    rcfg = wf_cfg["resolutions"][rm]
    s1_w, s1_h = int(rcfg["s1_w"]), int(rcfg["s1_h"])
    s2_w, s2_h = int(rcfg["s2_w"]), int(rcfg["s2_h"])

    enable_hires = bool(wf_cfg.get("enable_hires", True))
    st = (step_tier or "").strip().lower()
    if st not in ("tier1", "tier2", "tier3"):
        tiers = wf_cfg["step_tiers"]
        def _tot(tk):
            t = tiers[tk]
            return int(t["s1"]) + (int(t["ref"]) if enable_hires and int(t["ref"]) > 0 else 0)
        if raw_steps <= 0 or raw_steps == _tot("tier2"):
            st = "tier2"
        elif raw_steps == _tot("tier1"):
            st = "tier1"
        elif raw_steps == _tot("tier3"):
            st = "tier3"
        elif raw_steps <= 13:
            st = "tier1"
        elif raw_steps <= 18:
            st = "tier2"
        else:
            st = "tier3"
    tcfg = wf_cfg["step_tiers"][st]
    s1_steps = int(tcfg["s1"])
    ref_steps = int(tcfg["ref"])
    use_hires = enable_hires and ref_steps > 0
    total_steps = (s1_steps + ref_steps) if use_hires else s1_steps
    return s1_w, s1_h, s2_w, s2_h, s1_steps, ref_steps, total_steps, use_hires


def build_tunnel_image_workflow(unet_file: str, raw_prompt: str, width: int, height: int, raw_steps: int, guidance: float, seed: int, uploaded_refs=None, settings: dict = None, res_mode: str = "", step_tier: str = ""):
    cur_settings = settings if isinstance(settings, dict) else load_studio_settings()
    ip = cur_settings["image_prompt"]
    wf_cfg = cur_settings["image_workflow"]
    prompt = _apply_prompt_affixes_local(raw_prompt, ip)
    s1_w, s1_h, s2_w, s2_h, s1_steps, ref_steps, total_steps, use_hires = _resolve_res_and_steps(
        wf_cfg, width, height, raw_steps, res_mode=res_mode, step_tier=step_tier
    )
    cfg = float(guidance) if guidance and guidance > 0 else float(wf_cfg.get("cfg", 1.0))
    sampler_name = wf_cfg.get("sampler_name", "euler")
    scheduler = wf_cfg.get("scheduler", "simple")
    upscale_method = wf_cfg.get("upscale_method", "lanczos")
    hires_denoise = float(wf_cfg.get("hires_denoise", 0.16))

    init_w, init_h = (s1_w, s1_h) if use_hires else (s2_w, s2_h)
    wf3k = {
        "10": {"class_type": "UNETLoader", "inputs": {"unet_name": unet_file, "weight_dtype": "default"}},
        "11": {"class_type": "CLIPLoader", "inputs": {"clip_name": IMAGE_CLIP_FILE, "type": IMAGE_CLIP_TYPE, "device": "default"}},
        "12": {"class_type": "VAELoader", "inputs": {"vae_name": IMAGE_VAE_FILE}},
        "5": {"class_type": "EmptyLatentImage", "inputs": {"width": init_w, "height": init_h, "batch_size": 1}},
    }

    uploaded_refs = list(uploaded_refs or [])
    if uploaded_refs:
        face_p = _format_ref_face_prompt(prompt, ip)
        edit_inputs = {"clip": ["11", 0], "prompt": face_p}
        scale_w = int(ip.get("ref_scale_w", 768))
        scale_h = int(ip.get("ref_scale_h", 1152))
        crop_w = int(ip.get("ref_crop_w", 512))
        crop_h = int(ip.get("ref_crop_h", 448))
        crop_x = int(ip.get("ref_crop_x", 128))
        crop_y = int(ip.get("ref_crop_y", 0))
        for idx, rname in enumerate(uploaded_refs, start=1):
            nid_load = str(100 + idx)
            nid_scale = str(110 + idx)
            nid_crop = str(120 + idx)
            wf3k[nid_load] = {"class_type": "LoadImage", "inputs": {"image": rname}}
            wf3k[nid_scale] = {"class_type": "ImageScale", "inputs": {"image": [nid_load, 0], "upscale_method": "lanczos", "width": scale_w, "height": scale_h, "crop": "center"}}
            wf3k[nid_crop] = {"class_type": "ImageCrop", "inputs": {"image": [nid_scale, 0], "width": crop_w, "height": crop_h, "x": crop_x, "y": crop_y}}
            edit_inputs[f"image{idx}"] = [nid_crop, 0]
        wf3k["52"] = {"class_type": "TextEncodeQwenImageEditPlus", "inputs": edit_inputs}
        wf3k["13"] = {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["52", 0]}}
        pos_node = "52"
    else:
        wf3k["6"] = {"class_type": "CLIPTextEncode", "inputs": {"clip": ["11", 0], "text": prompt}}
        wf3k["13"] = {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["6", 0]}}
        pos_node = "6"

    wf3k["3"] = {
        "class_type": "KSampler",
        "inputs": {
            "model": ["10", 0], "positive": [pos_node, 0], "negative": ["13", 0],
            "latent_image": ["5", 0], "seed": seed, "steps": s1_steps,
            "cfg": cfg, "sampler_name": sampler_name, "scheduler": scheduler, "denoise": 1.0,
        },
    }
    wf3k["8"] = {"class_type": "VAEDecode", "inputs": {"samples": ["3", 0], "vae": ["12", 0]}}
    if use_hires:
        wf3k["20"] = {"class_type": "ImageScale", "inputs": {"image": ["8", 0], "upscale_method": upscale_method, "width": s2_w, "height": s2_h, "crop": "disabled"}}
        wf3k["21"] = {"class_type": "VAEEncode", "inputs": {"pixels": ["20", 0], "vae": ["12", 0]}}
        wf3k["22"] = {
            "class_type": "KSampler",
            "inputs": {
                "model": ["10", 0], "positive": [pos_node, 0], "negative": ["13", 0],
                "latent_image": ["21", 0], "seed": seed + 1, "steps": ref_steps,
                "cfg": cfg, "sampler_name": sampler_name, "scheduler": scheduler, "denoise": hires_denoise,
            },
        }
        wf3k["23"] = {"class_type": "VAEDecode", "inputs": {"samples": ["22", 0], "vae": ["12", 0]}}
        wf3k["29"] = {"class_type": "SaveImage", "inputs": {"images": ["23", 0], "filename_prefix": "img3k"}}
    else:
        wf3k["29"] = {"class_type": "SaveImage", "inputs": {"images": ["8", 0], "filename_prefix": "img3k"}}
    return wf3k, s2_w, s2_h, total_steps, s1_steps, ref_steps, use_hires


def _upload_image_to_comfy_tunnel(local_path: str) -> str:
    _check_generation()
    boundary = "----ComfyUp" + uuid.uuid4().hex
    fname = f"ref_{int(time.time()*1000)}_{os.path.basename(local_path)}"
    ctype = mimetypes.guess_type(local_path)[0] or "image/jpeg"
    body = bytearray()
    body.extend(f"--{boundary}\r\n".encode())
    body.extend(b'Content-Disposition: form-data; name="overwrite"\r\n\r\ntrue\r\n')
    body.extend(f"--{boundary}\r\n".encode())
    body.extend(f'Content-Disposition: form-data; name="image"; filename="{fname}"\r\nContent-Type: {ctype}\r\n\r\n'.encode())
    with open(local_path, "rb") as fh:
        body.extend(fh.read())
    body.extend(f"\r\n--{boundary}--\r\n".encode())
    req = urllib.request.Request(
        f"http://127.0.0.1:{COMFY_TUNNEL_PORT}/upload/image",
        data=bytes(body),
        headers={"Content-Type": f"multipart/form-data; boundary={boundary}"},
    )
    res = json.loads(urllib.request.urlopen(req, timeout=20).read().decode())
    return res["name"]


def _submit_comfy_tunnel(wf: dict, label: str, prefix: str, width: int, height: int, steps: int, seed: int, out_subdir: str = "image", ext: str = ".png") -> str:
    t0 = time.time()
    payload = json.dumps({"prompt": wf}).encode("utf-8")
    _check_generation()
    req = urllib.request.Request(f"http://127.0.0.1:{COMFY_TUNNEL_PORT}/prompt", data=payload, headers={"Content-Type": "application/json"})
    resp = json.loads(urllib.request.urlopen(req, timeout=20).read().decode())
    prompt_id = resp["prompt_id"]
    print(f"[{out_subdir}] 已通过并行隧道提交 {label} 任务 (prompt_id={prompt_id}, {width}x{height}, steps={steps})...", flush=True)
    while True:
        _check_generation()
        time.sleep(0.35)
        hist = json.loads(urllib.request.urlopen(f"http://127.0.0.1:{COMFY_TUNNEL_PORT}/history/{prompt_id}", timeout=15).read().decode())
        if prompt_id in hist:
            entry = hist[prompt_id]
            status = entry.get("status", {})
            if status.get("status_str") == "error":
                raise SystemExit(f"[colab-ai] ComfyUI 任务失败（不自动重复派发）: {json.dumps(status, ensure_ascii=False)}")
            for node_out in entry.get("outputs", {}).values():
                for val in node_out.values():
                    if isinstance(val, list):
                        for item in val:
                            if isinstance(item, dict) and "filename" in item:
                                q = urllib.parse.urlencode({
                                    "filename": item["filename"],
                                    "subfolder": item.get("subfolder", ""),
                                    "type": item.get("type", "output"),
                                })
                                file_bytes = urllib.request.urlopen(f"http://127.0.0.1:{COMFY_TUNNEL_PORT}/view?{q}", timeout=60).read()
                                local_out_dir = os.path.join(OUT_ROOT, out_subdir)
                                os.makedirs(local_out_dir, exist_ok=True)
                                actual_ext = os.path.splitext(item["filename"])[1] or ext
                                lpath = os.path.join(local_out_dir, f"{prefix}_{int(time.time())}_{seed}{actual_ext}")
                                with open(lpath, "wb") as fh:
                                    fh.write(file_bytes)
                                dt = time.time() - t0
                                print(f"[{out_subdir}] {label} 生成完成 ({dt:.2f}s, {width}x{height}, steps={steps}, seed={seed})", flush=True)
                                print(f"[colab-ai] 已回传至宿主机本地: {lpath}", flush=True)
                                return lpath


IMAGE_KEYS = ("v5_int8",)
WARMUP_KEYS = IMAGE_KEYS + ("video", "llm")
MODEL_LABELS = {"v5_int8": IMAGE_LABEL, "video": "24fps 声画视频", "llm": "提示词 LLM"}


def _validate_warmup_targets(targets):
    if not isinstance(targets, list) or not 1 <= len(targets) <= 3 or any(not isinstance(t, str) or t not in WARMUP_KEYS for t in targets):
        raise ValueError("预热 targets 必须是1至3项明确模型key的非空列表；不接受未知项目")
    return list(dict.fromkeys(targets))


def _parse_warmup_args(args):
    args = list(args)
    if args and args[0] == "--targets":
        return _validate_warmup_targets(args[1:])
    if any(a == "--targets" or a.startswith("--targets=") for a in args):
        raise ValueError("--targets 必须单独指定，不能与旧预热参数混用")
    model = "v5_int8"
    mods = []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == "--image-model":
            i += 1
            if i >= len(args):
                raise ValueError("缺少 --image-model 值")
            model = args[i]
        elif arg.startswith("--image-model="):
            model = arg.split("=", 1)[1]
        elif arg in ("image", "video", "llm"):
            mods.append(arg)
        else:
            raise ValueError("未知预热参数")
        i += 1
    if model not in IMAGE_KEYS:
        raise ValueError("未知预热图像模型")
    return _validate_warmup_targets([model if m == "image" else m for m in (mods or ["image", "llm"])])


def _validate_image_args(mod_args):
    p = argparse.ArgumentParser(add_help=False)
    p.add_argument("--model", "-m", default="v5_int8")
    args, _ = p.parse_known_args(mod_args)
    mk = args.model.lower().strip()
    if mk in ("edit", "image_edit"):
        raise SystemExit("改图模块暂未启用")
    allowed_single = ("v5_int8", "v5-int8", "v5_int8_convrot", "flux_int8", "dit_int8", "default", "v5_bf16", "v5-bf16", "v5", "flux_bf16", "dit_bf16")
    if "--warmup-only" in mod_args:
        parts = [x.strip() for x in mk.split(",") if x.strip()]
        if not parts or any(x not in ("v5_int8", "v5-int8", "v5_int8_convrot", "flux_int8", "dit_int8", "default") for x in parts):
            raise SystemExit("预热仅接受默认生图模型键 v5_int8")
    elif mk not in allowed_single:
        raise SystemExit("未知生图模型键；默认使用 v5_int8")
    return mk


