def ensure_port_proxy():
    """可选 ComfyUI 端口转发：仅在显式启用且端口尚未被容器入口进程监听时后台拉起。"""
    enabled = os.environ.get("COLABBB_ENABLE_COMFY_PROXY", "").strip().lower() in ("1", "true", "yes", "on")
    if not enabled and not os.path.exists(os.path.join(STATE_DIR, "enable_comfy_proxy")):
        return
    proxy_port = int(os.environ.get("COLABBB_COMFY_PROXY_PORT", "18188"))
    try:
        with socket.create_connection(("127.0.0.1", proxy_port), timeout=0.4):
            return
    except OSError:
        pass
    proxy_script = os.path.join(BASE_DIR, "optional", "comfy-proxy", "comfy_port_proxy.py")
    if not os.path.isfile(proxy_script):
        return
    pid_f = os.path.join(STATE_DIR, "proxy.pid")
    if os.path.exists(pid_f):
        try:
            pid = int(open(pid_f).read().strip())
            os.kill(pid, 0)
            return
        except Exception:
            pass
    proc = subprocess.Popen(
        [sys.executable, proxy_script],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
    )
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    open(pid_f, "w").write(str(proc.pid))


@idle_work
def ensure_session(session: str, gpu: str, idle_min: int, allow_create: bool = True):
    _check_generation()
    touch_activity()
    ensure_port_proxy()
    with session_start_lock(session) as lock:
        _check_generation()
        if _auto_attach_remote_session_locked(session):
            _set_start_pending(lock, False)
            start_idle_watcher(session, idle_min)
            return
        if not allow_create:
            _lifecycle_event("session_decision", decision="refuse_create", old_endpoint=_local_endpoint(session))
            raise SystemExit("[colab-ai] 当前未开机，请先开机。")
        lock.seek(0)
        if lock.read().strip():
            raise SystemExit("[colab-ai] 上次创建结果尚未确认且远端仍为空；拒绝再次创建，请先核实远端状态。")
        _check_generation()
        _set_start_pending(lock, True)
        _lifecycle_event("session_decision", decision="new", old_endpoint=_local_endpoint(session))
        print(f"[colab-ai] 正在开启 Colab {gpu} 实例 (session={session})...", flush=True)
        try:
            env = dict(os.environ, COLAB_CLI_ASSIGN_RETRIES="0")
            subprocess.run([COLAB_BIN, "new", "-s", session, "--gpu", gpu], check=True, env=env)
        except (subprocess.SubprocessError, OSError) as exc:
            _lifecycle_event("new_call_end", result="unconfirmed", error_type=type(exc).__name__, endpoint=_local_endpoint(session))
            start_idle_watcher(session, idle_min)
            raise SystemExit("[colab-ai] 创建结果未确认；已保留启动保护，禁止盲目再次创建。") from None
        _lifecycle_event("new_call_end", result="returned_success", endpoint=_local_endpoint(session))
        start_idle_watcher(session, idle_min)
        ready = False
        for _attempt in range(8):
            time.sleep(2.5)
            if not _auto_attach_remote_session_locked(session):
                continue
            _set_start_pending(lock, False)
            start_idle_watcher(session, idle_min)
            _rdy_p = os.path.join(STATE_DIR, "kernel-ready-" + hashlib.sha256(session.encode()).hexdigest() + ".py")
            with open(_rdy_p, "w") as fh:
                fh.write("print('KERNEL_READY')\n")
            try:
                probe = subprocess.run(
                    [COLAB_BIN, "exec", "-s", session, "--timeout", "15", "-f", _rdy_p],
                    text=True, capture_output=True, timeout=25,
                )
            except subprocess.TimeoutExpired:
                continue
            if probe.returncode == 0 and "KERNEL_READY" in (probe.stdout or ""):
                ready = True
                try:
                    _mp = os.path.join(BASE_DIR, "remote_metrics.py")
                    if os.path.isfile(_mp):
                        m_cmd = [COLAB_BIN, "exec", "-s", session, "--timeout", "20"] + _build_remote_env_flags() + ["-f", _mp]
                        subprocess.Popen(m_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
                except Exception:
                    pass
                break
        start_idle_watcher(session, idle_min)
        if not ready:
            raise SystemExit("[colab-ai] 实例已创建，但 Kernel 就绪探测耗尽；未就绪，不会再次创建。")
        print(f"[colab-ai] {gpu} 已就绪（已启用 {idle_min} 分钟闲置自动关机保护）。", flush=True)


def prepare_remote_args(module: str, raw_args: list, session: str) -> list:
    file_flags = {"--input", "-i", "--prompt-file", "-f", "--messages-file", "--system-file", "--text-file", "--workflow", "-w", "--image", "--ref-image"}
    new_args = []
    i = 0
    while i < len(raw_args):
        arg = raw_args[i]
        if arg == "--out-file" and i + 1 < len(raw_args):
            i += 2
            continue
        if arg == "--ephemeral-draft":
            i += 1
            continue
        if arg in file_flags and i + 1 < len(raw_args):
            local_p = raw_args[i + 1]
            remote_p = maybe_upload_file(module, local_p, session)
            new_args.extend([arg, remote_p])
            i += 2
            continue
        new_args.append(arg)
        i += 1
    return new_args


def maybe_upload_file(module: str, local_path: str, session: str) -> str:
    if not os.path.isfile(local_path):
        return local_path
    upload_src = local_path
    remote_path = f"/content/inputs/{os.path.basename(upload_src)}"
    mk_p = os.path.join(STATE_DIR, "mkdir-inputs.py")
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    with open(mk_p, "w", encoding="utf-8") as _mfh:
        _mfh.write("import os; os.makedirs('/content/inputs', exist_ok=True)\n")
    for _up_try in range(3):
        _check_generation()
        try:
            auto_attach_remote_session(session)
            subprocess.run([COLAB_BIN, "exec", "-s", session, "--timeout", "20", "-f", mk_p], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
            print(f"[colab-ai] 正在上传输入文件: {upload_src} -> {remote_path}", flush=True)
            up_res = subprocess.run([COLAB_BIN, "upload", "-s", session, upload_src, remote_path], timeout=90)
            if up_res.returncode == 0:
                break
        except subprocess.TimeoutExpired:
            print(f"[colab-ai] 上传通道响应超时，自动重试 ({_up_try+1}/3)...", flush=True)
        time.sleep(3)
    else:
        raise SystemExit(1)
    return remote_path


