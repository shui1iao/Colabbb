state.store.add(s)
print(f"ATTACHED:{{s.endpoint}}:{{s.accelerator}}")
'''
    old_endpoint = _local_endpoint(session)
    _lifecycle_event("assignment_query_begin", old_endpoint=old_endpoint)
    try:
        res = subprocess.run(
            [_resolve_colab_python(), "-c", code],
            capture_output=True, text=True, timeout=15,
        )
    except (subprocess.TimeoutExpired, OSError) as exc:
        _lifecycle_event("assignment_query_end", result="error", old_endpoint=old_endpoint, error_type=type(exc).__name__)
        raise SystemExit("[colab-ai] 状态查询失败：远端会话查询超时或无法运行；未确认无实例，拒绝创建。") from None
    lines = (res.stdout or "").splitlines()
    endpoints = None
    for line in lines:
        if line.startswith("COLAB_AI_ASSIGNMENTS_JSON="):
            try:
                candidate = json.loads(line.split("=", 1)[1])
                if isinstance(candidate, list) and all(isinstance(ep, str) and re.fullmatch(r"(?:gpu|cpu|tpu)-[A-Za-z0-9_-]{1,160}", ep) for ep in candidate):
                    endpoints = candidate
            except (TypeError, ValueError):
                pass
    _lifecycle_event(
        "assignment_query_end",
        old_endpoint=old_endpoint,
        endpoints=endpoints,
        result=("empty" if not endpoints else "nonempty") if endpoints is not None else "error",
        returncode=res.returncode,
    )
    if res.returncode == 3 and lines and lines[-1] == "COLAB_AI_ASSIGNMENTS_EMPTY":
        return False
    if res.returncode == 0:
        attached = [x for x in lines if x.startswith("ATTACHED:")]
        if attached:
            parts = attached[-1].split(":", 2)
            if len(parts) == 3 and parts[1] and parts[2]:
                _, ep, acc = parts
                _lifecycle_event("session_decision", decision="reuse", old_endpoint=old_endpoint, endpoint=ep)
                print(f"[colab-ai] 已自动识别并接管远端活跃实例 [{session}] -> {ep} (GPU: {acc})", flush=True)
                return True
    raise SystemExit("[colab-ai] 状态查询失败：远端会话查询/绑定失败或响应无效；未确认无实例，拒绝创建。")


