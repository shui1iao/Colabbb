# ============================================================================
# Colabbb 统一配置模板 (复制为 .env 并按需填写)
# ============================================================================

# 容器内路径固定在镜像默认值；所有运行数据持久化到 ./data:/data。
# 复制本文件为 .env (chmod 600)，只需填写公网 IP 或域名即可配置隧道。
# COLABBB_HOME=/app
# COLABBB_STATE_DIR=/data/state
# COLABBB_OUTPUT_DIR=/data/outputs
# HOME=/data/home
# PYTHON_KEYRING_BACKEND=keyrings.alt.file.PlaintextKeyring

# 宿主机面板绑定地址与发布端口（容器内始终为 17860）
COLABBB_BIND_IP=127.0.0.1
COLABBB_PANEL_PORT=17860

# Colab CLI 路径与会话参数
COLAB_BIN=/usr/local/bin/colab
COLAB_SESSION=ai
COLAB_GPU=G4
# 首选 GPU 售罄或限流时的阶梯回退顺序（支持 A100-HM 表示 A100 80GB 高内存）
COLAB_GPU_FALLBACKS=A100-HM,A100,H100
# 多账号登录时允许开机阶段自动轮换接管/试卡（1=开启，0=仅使用当前选中账号）
COLAB_MULTI_ACCOUNT_FAILOVER=1
# 可选：显式指定 Colab Public API 使用的 GCP 配额项目 ID；留空则自动发现账号下可用项目并尝试启用 colaboratory.googleapis.com
COLABBB_QUOTA_PROJECT=
COLAB_IDLE_MIN=30
COLAB_TIMEOUT=7200

# ----------------------------------------------------------------------------
# 反向 SSH 隧道（唯一必填：GPU 可达的公网 IP / 域名）
# 容器自动生成密钥并授权给内置 sshd，不操作宿主机 SSH。
# ----------------------------------------------------------------------------
COLABBB_TUNNEL_HOST=your-server-ip-or-domain.example.com
COLABBB_TUNNEL_PORT=22222
COLABBB_TUNNEL_USER=tunnel
COLABBB_INTERNAL_SSHD=1

# 可选首次无人值守管理员初始化（密码至少12字符；完成后删除并重建容器）
# COLABBB_ADMIN_USER=admin
# COLABBB_ADMIN_PASS=

# 可选 Telegram Bot（容器内后台服务；空授权名单拒绝所有请求）
COLABBB_ENABLE_TGBOT=0
TG_BOT_TOKEN=
TG_ALLOWED_USERS=

# ----------------------------------------------------------------------------
# 可选：Web 面板右上角 ComfyUI 快捷入口链接
# - 留空：前端自动使用 http://<当前访问域名>:18188/
# - 设为 hide 或 off：隐藏右上角 ComfyUI 按钮
# - 设为完整 URL（如 https://comfy.example.com/）：直接跳转至指定地址
# ----------------------------------------------------------------------------
COLABBB_COMFY_URL=

# 可选：ComfyUI 公网端口代理监听配置（启用 comfy-proxy 模块时生效）
COLABBB_COMFY_PROXY_HOST=0.0.0.0
COLABBB_COMFY_PROXY_PORT=18188
COLABBB_COMFY_TARGET_HOST=127.0.0.1
COLABBB_COMFY_TARGET_PORT=28188
COLABBB_ENABLE_COMFY_PROXY=0

# ----------------------------------------------------------------------------
# 可选：Google Drive AES-256-GCM 加密作品镜像 & Telegram 频道同步（默认关闭）
# 启用后 Web 面板作品库工具栏出现「谷歌同步 ▾」浮层，支持云盘与频道分开同步
# ----------------------------------------------------------------------------
COLABBB_ENABLE_DRIVE_SYNC=0
COLABBB_DRIVE_AES_KEY_HEX=
COLABBB_DRIVE_GCP_PROJECT=
COLABBB_DRIVE_SYNC_EMAIL=
COLABBB_DRIVE_FOLDER_NAME=Colabbb-Gallery
TG_SYNC_CHANNEL_ID=
TG_SYNC_CHANNEL_NAME=

# ----------------------------------------------------------------------------
# 可选：模型下载鉴权 Token（拉取受限 HuggingFace 或 Civitai 权重时按需填写）
# ----------------------------------------------------------------------------
HF_TOKEN=
CIVITAI_TOKEN=

# ----------------------------------------------------------------------------
# 可选：自定义远端模型仓库与权重文件名覆盖（不填则使用内置公开默认配置）
# ----------------------------------------------------------------------------
# 生图模型 (ComfyUI UNET + CLIP + VAE)
# COLABBB_IMAGE_LABEL=Flux / DiT INT8
# COLABBB_IMAGE_UNET_REPO=Comfy-Org/Krea-2
# COLABBB_IMAGE_UNET_PATH=split_files/diffusion_models/krea2_dev_fp8_e4m3fn.safetensors
# COLABBB_IMAGE_UNET_FILE=krea2_dev_fp8_e4m3fn.safetensors
# COLABBB_IMAGE_CLIP_REPO=Comfy-Org/Krea-2
# COLABBB_IMAGE_CLIP_PATH=split_files/text_encoders/qwen_3_4b.safetensors
# COLABBB_IMAGE_CLIP_FILE=qwen_3_4b.safetensors
# COLABBB_IMAGE_VAE_REPO=Comfy-Org/Krea-2
# COLABBB_IMAGE_VAE_PATH=vae/qwen_image_vae.safetensors
# COLABBB_IMAGE_VAE_FILE=qwen_image_vae.safetensors

# 提示词大师 LLM (llama.cpp GGUF)
# COLABBB_LLM_LABEL=Qwen 27B GGUF (llama-server)
# COLABBB_LLM_REPO=bartowski/Qwen_Qwen3-30B-A3B-GGUF
# COLABBB_LLM_FILE=Qwen_Qwen3-30B-A3B-Q4_K_M.gguf

# 24fps 声画同步视频模型 (MiniMax-H3)
# COLABBB_VIDEO_UNET_REPO=Comfy-Org/MiniMax-H3
# COLABBB_VIDEO_UNET_FILE=minimax_h3_fp8_e4m3fn.safetensors
# COLABBB_VIDEO_CLIP_REPO=Comfy-Org/MiniMax-H3
# COLABBB_VIDEO_CLIP_PATH=text_encoders/qwen_3_vl_32b_minimax_h3_fp8_e4m3fn.safetensors
# COLABBB_VIDEO_CLIP_FILE=qwen_3_vl_32b_minimax_h3_fp8_e4m3fn.safetensors
