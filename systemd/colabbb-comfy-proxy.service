[Unit]
Description=Colabbb comfy-proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/colabbb
Environment=COLABBB_HOME=/opt/colabbb
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/opt/colabbb/config.env
ExecStart=/usr/bin/python3 /opt/colabbb/optional/comfy-proxy/comfy_port_proxy.py
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
